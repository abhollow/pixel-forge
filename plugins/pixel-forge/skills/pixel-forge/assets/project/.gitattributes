# LF everywhere, so Windows checkouts stop showing project.godot and
# export_presets.cfg as modified for line endings alone.
* text=auto eol=lf

# Binary assets: never touch their bytes.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.bmp binary
*.ico binary
*.icns binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.res binary
*.scn binary
*.zip binary
*.apk binary
*.aab binary
*.keystore binary
*.jks binary

# Windows scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
